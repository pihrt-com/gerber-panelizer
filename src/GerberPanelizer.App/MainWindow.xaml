<Window x:Class="GerberPanelizer.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:GerberPanelizer.App"
        Title="Gerber Panelizer" Icon="pack://application:,,,/Assets/gerber-panelizer-icon.png" Width="1360" Height="850" MinWidth="1050" MinHeight="680" WindowStartupLocation="CenterScreen" Background="#F3F7F6">
    <Window.Resources>
        <Style x:Key="HeaderButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#E6F3F1" />
            <Setter Property="BorderBrush" Value="#4D8580" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Margin" Value="5,0,0,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SmallActionButton" TargetType="Button">
            <Setter Property="Background" Value="#E5F1EF" />
            <Setter Property="Foreground" Value="#145C57" />
            <Setter Property="BorderBrush" Value="#C8E0DD" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="Margin" Value="4,0,0,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#0B766E" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="15,9" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="LayerToggle" TargetType="CheckBox">
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>
    <Window.InputBindings>
        <KeyBinding Key="Delete" Command="{Binding DeleteBoardCommand}" />
    </Window.InputBindings>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="82" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="34" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#103F3B" Padding="28,12">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="{Binding VersionCaption}" Foreground="#E4F3F0" FontSize="12" HorizontalAlignment="Right" />
                        <TextBlock Text="{Binding BuildCaption}" Foreground="#B9D6D2" FontSize="10" HorizontalAlignment="Right" />
                    </StackPanel>
                    <Button Command="{Binding CheckForUpdatesCommand}" ToolTip="{Binding Source={x:Static local:LocalizationService.Instance}, Path=[UpdateCheck]}" Style="{StaticResource HeaderButton}" Padding="10,7">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE777;" />
                    </Button>
                    <Button Command="{Binding OpenSettingsCommand}" ToolTip="{Binding Source={x:Static local:LocalizationService.Instance}, Path=[Settings]}" Style="{StaticResource HeaderButton}" Padding="10,7">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE713;" />
                    </Button>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel Margin="0,0,18,0">
                        <TextBlock Text="Gerber Panelizer" Foreground="White" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock Foreground="#D0E6E2" FontSize="12">
                            <Run Text="Martin Pihrt  |  " />
                            <Hyperlink NavigateUri="https://www.pihrt.com" RequestNavigate="OpenWebsite">www.pihrt.com</Hyperlink>
                        </TextBlock>
                    </StackPanel>
                    <Border Width="1" Height="36" Background="#4D8580" Margin="0,0,9,0" />
                    <Button Style="{StaticResource HeaderButton}" Command="{Binding NewProjectCommand}">
                        <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE710;" Margin="0,0,6,0" /><TextBlock Text="{Binding Source={x:Static local:LocalizationService.Instance}, Path=[NewProject]}" /></StackPanel>
                    </Button>
                    <Button Style="{StaticResource HeaderButton}" Command="{Binding SaveProjectCommand}">
                        <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE74E;" Margin="0,0,6,0" /><TextBlock Text="{Binding Source={x:Static local:LocalizationService.Instance}, Path=[SaveProject]}" /></StackPanel>
                    </Button>
                    <Button Style="{StaticResource HeaderButton}" Command="{Binding LoadProjectCommand}">
                        <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8E5;" Margin="0,0,6,0" /><TextBlock Text="{Binding Source={x:Static local:LocalizationService.Instance}, Path=[LoadProject]}" /></StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="270" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" BorderBrush="#D4E1DF" BorderThickness="1" CornerRadius="9" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Button Grid.Row="0" Command="{Binding ImportCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Stretch">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8B7;" Margin="0,0,8,0" /><TextBlock Text="{Binding Source={x:Static local:LocalizationService.Instance}, Path=[ImportFiles]}" /></StackPanel>
                    </Button>
                    <TextBlock Grid.Row="2" Text="{Binding Source={x:Static local:LocalizationService.Instance}, Path=[ImportedBoards]}" FontWeight="SemiBold" Foreground="#244542" />
                    <ListBox Grid.Row="3" ItemsSource="{Binding Boards}" SelectedItem="{Binding SelectedBoard, Mode=TwoWay}" BorderThickness="0" Background="Transparent" Margin="0,8,0,8">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="8" Margin="0,0,0,5" Background="#F3F8F7" CornerRadius="5">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <CheckBox IsChecked="{Binding IsIncluded}" FontWeight="SemiBold" Foreground="#184E49" Content="{Binding Name}" />
                                            <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="#5B7774" Margin="19,3,0,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Style="{StaticResource SmallActionButton}" Command="{Binding DataContext.CloneBoardCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" ToolTip="{Binding Source={x:Static local:LocalizationService.Instance}, Path=[CloneBoard]}" Padding="6,4"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE710;" /></Button>
                                            <Button Style="{StaticResource SmallActionButton}" Command="{Binding DataContext.DeleteBoardCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" ToolTip="{Binding Source={x:Static local:LocalizationService.Instance}, Path=[DeleteBoard]}" Padding="6,4"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE74D;" /></Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel Grid.Row="4">
                        <TextBlock Text="{Binding Source={x:Static local:LocalizationService.Instance}, Path=[ManufacturingSide]}" FontSize="12" Foreground="#486764" Margin="0,0,0,6" />
                        <UniformGrid Columns="3">
                            <Button Command="{Binding SelectSideCommand}" CommandParameter="Top" Style="{StaticResource SmallActionButton}" Margin="0,0,3,0" Content="{Binding Source={x:Static local:LocalizationService.Instance}, Path=[SideTop]}" />
                            <Button Command="{Binding SelectSideCommand}" CommandParameter="Bottom" Style="{StaticResource SmallActionButton}" Margin="3,0" Content="{Binding Source={x:Static local:LocalizationService.Instance}, Path=[SideBottom]}" />
                            <Button Command="{Binding SelectSideCommand}" CommandParameter="Both" Style="{StaticResource SmallActionButton}" Margin="3,0,0,0" Content="{Binding Source={x:Static local:LocalizationService.Instance}, Path=[SideBoth]}" />
                        </UniformGrid>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="52" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="52" />
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Background="White" BorderBrush="#D4E1DF" BorderThickness="1" CornerRadius="9" Padding="14,0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" Text="{Binding Source={x:Static local:LocalizationService.Instance}, Path=[Layers]}" FontWeight="SemiBold" Foreground="#244542" VerticalAlignment="Center" Margin="0,0,16,0" />
                        <ItemsControl ItemsSource="{Binding Layers}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Style="{StaticResource LayerToggle}" IsChecked="{Binding IsVisible}">
                                        <StackPanel Orientation="Horizontal"><Ellipse Width="9" Height="9" Fill="{Binding Brush}" Margin="0,0,5,0" /><TextBlock Text="{Binding Name}" /></StackPanel>
                                    </CheckBox>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DockPanel>
                </Border>

                <Border Grid.Row="1" Background="#EAF1F0" BorderBrush="#D4E1DF" BorderThickness="1" CornerRadius="9" Margin="0,12,0,12" Padding="16">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Source={x:Static local:LocalizationService.Instance}, Path=[WorkArea]}" Foreground="#486764" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding WorkAreaCaption}" Margin="6,0,0,0" Foreground="#145C57" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Source={x:Static local:LocalizationService.Instance}, Path=[ZoomHint]}" Margin="22,0,0,0" Foreground="#6A8582" FontSize="11" VerticalAlignment="Center" />
                        </StackPanel>
                        <Border Grid.Row="1" Background="White" BorderBrush="#0B766E" BorderThickness="2" Margin="0,14,0,0" ClipToBounds="True">
                            <Grid>
                                <local:PanelPreviewControl Placements="{Binding RenderPlacements}" Layers="{Binding Layers}" PanelWidthMm="{Binding WorkAreaWidthMm}" PanelHeightMm="{Binding WorkAreaHeightMm}" MovePlacementCommand="{Binding MovePlacementCommand}" DeletePlacementCommand="{Binding DeletePlacementCommand}" />
                                <StackPanel Visibility="{Binding EmptyPreviewVisibility}" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                                    <TextBlock Text="{Binding Source={x:Static local:LocalizationService.Instance}, Path=[CanvasEmptyTitle]}" FontSize="18" FontWeight="SemiBold" Foreground="#42615E" HorizontalAlignment="Center" />
                                    <TextBlock Text="{Binding Source={x:Static local:LocalizationService.Instance}, Path=[CanvasEmptyHint]}" Margin="0,6,0,0" Foreground="#71908D" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <Grid Grid.Row="2">
                    <TextBlock Text="{Binding Source={x:Static local:LocalizationService.Instance}, Path=[Tip]}" Foreground="#5B7774" VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Command="{Binding PanelizeCommand}" Style="{StaticResource SmallActionButton}" Margin="0,0,8,0"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE895;" Margin="0,0,6,0" /><TextBlock Text="{Binding Source={x:Static local:LocalizationService.Instance}, Path=[Panelize]}" /></StackPanel></Button>
                        <Button Command="{Binding PrintCommand}" Style="{StaticResource SmallActionButton}" Margin="0,0,8,0"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE749;" Margin="0,0,6,0" /><TextBlock Text="{Binding Source={x:Static local:LocalizationService.Instance}, Path=[Print]}" /></StackPanel></Button>
                        <Button Command="{Binding ExportCommand}" Style="{StaticResource PrimaryButton}"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xEDE1;" Margin="0,0,7,0" /><TextBlock Text="{Binding Source={x:Static local:LocalizationService.Instance}, Path=[Export]}" /></StackPanel></Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>

        <Expander Grid.Row="2" IsExpanded="{Binding IsStatusLogExpanded, Mode=TwoWay}" Background="#F8FBFA" BorderBrush="#D4E1DF" BorderThickness="1,1,0,0">
            <Expander.Header>
                <StackPanel Orientation="Horizontal" Margin="18,5"><TextBlock Text="{Binding Source={x:Static local:LocalizationService.Instance}, Path=[StatusLog]}" FontWeight="SemiBold" Foreground="#244542" /><TextBlock Text="{Binding StatusEntries.Count, StringFormat=' ({0})'}" Foreground="#65817E" /></StackPanel>
            </Expander.Header>
            <ScrollViewer MaxHeight="190" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding StatusEntries}" Margin="22,0,22,10">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Expander IsExpanded="False" IsEnabled="{Binding HasDetails}" Margin="0,3,0,0">
                                <Expander.Header><TextBlock Text="{Binding Message}" Foreground="#345B57" TextWrapping="Wrap" /></Expander.Header>
                                <ItemsControl ItemsSource="{Binding Details}" Margin="20,4,0,4"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Foreground="#6A4E20" TextWrapping="Wrap" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                            </Expander>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Expander>

        <Border Grid.Row="3" Background="#E9F0EE" Padding="26,0">
            <DockPanel>
                <Button DockPanel.Dock="Right" Command="{Binding ToggleStatusLogCommand}" Style="{StaticResource SmallActionButton}" Padding="7,2" Margin="0" Content="{Binding Source={x:Static local:LocalizationService.Instance}, Path=[StatusLog]}" />
                <TextBlock VerticalAlignment="Center" Foreground="#42615E" FontSize="12" Text="{Binding StatusText}" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
