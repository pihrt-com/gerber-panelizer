<Project Sdk="WixToolset.Sdk/6.0.2">
  <PropertyGroup>
    <OutputType>Package</OutputType>
    <InstallerPlatform>x64</InstallerPlatform>
    <SkipBuildStamp>true</SkipBuildStamp>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <OutputName>GerberPanelizer-$(Version)-win-x64</OutputName>
    <PublishDirectory Condition="'$(PublishDirectory)' == ''">$(MSBuildProjectDirectory)\..\publish\win-x64-v$(Version)-ready</PublishDirectory>
    <LicenseRtfPath Condition="'$(LicenseRtfPath)' == ''">$(MSBuildProjectDirectory)\obj\generated\GPL-3.0.rtf</LicenseRtfPath>
    <DefineConstants>AppVersion=$(Version);PublishDirectory=$(PublishDirectory);LicenseRtfPath=$(LicenseRtfPath)</DefineConstants>
    <SuppressIces>ICE43;ICE57;ICE64;ICE69</SuppressIces>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Product.wxs" />
    <PackageReference Include="WixToolset.UI.wixext" Version="6.0.2" />
  </ItemGroup>
</Project>
